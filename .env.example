# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configurations
# NEXT_PUBLIC_ prefixes are used to make these accessible on the client side safely.
NEXT_PUBLIC_SUPABASE_URL="https://nsfugkhibwalzybremdd.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5zZnVna2hpYndhbHp5YnJlbWRkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI3MTkyOTcsImV4cCI6MjA5ODI5NTI5N30.72V3NMMae-DXwBGaeX0wjNoryCpmnWf81ST0rmyxPYw"

# Server-only configurations (Optional but recommended for secure API/Admin tasks)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ADMIN_BOOTSTRAP_EMAILS: Comma-separated list of emails granted Super Admin privileges upon login/registration.
# Set this in production to the site owner's email address(es).
# MUST NEVER be committed with real production email values or sensitive credentials to source control.
ADMIN_BOOTSTRAP_EMAILS="owner@yourdomain.com"

# Transactional Email Configuration (Resend)
# Obtain your API key from https://resend.com
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
# Sender email address. Ensure your domain is verified on Resend and DNS records (SPF, DKIM, DMARC) are configured.
EMAIL_FROM="Blue Hills Designers <orders@yourdomain.com>"

# Distributed Rate Limiting (Upstash Redis)
# Recommended for multi-instance production deployments (e.g. Vercel, Cloud Run replicas).
# If unconfigured, the application automatically falls back to local in-memory rate limiting for single-instance development.
UPSTASH_REDIS_REST_URL="https://your-database-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Flutterwave Payment Gateway Configurations
# Secret keys must remain server-side ONLY (never use NEXT_PUBLIC_ prefix for FLUTTERWAVE_SECRET_KEY)
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_WEBHOOK_SECRET_HASH="your_webhook_secret_hash_here"
PAYMENT_TEST_MODE="true"
